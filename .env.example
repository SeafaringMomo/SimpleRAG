# Copy to .env and fill in your own values. Never commit .env.
AI_BASE_URL=https://your-gateway.example.com/v1
AI_API_KEY=your-api-key

# 默认模型（名称以 GET /v1/models 返回的为准）
CHAT_MODEL=DeepSeek-V4.1-Flash
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=0

# 批量模型配置，格式为：模型名称:模型厂商:模型类别，多个模型用逗号分隔
MODELS=DeepSeek-V4.1-Flash:deepseek:chat,bge-m3:bge:embedding

# Milvus（database 只能包含字母、数字和下划线；不存在时自动创建）
MILVUS_URI=http://your-milvus-host:19530
MILVUS_TOKEN=your-milvus-token
MILVUS_DATABASE=apptest_database
MILVUS_COLLECTION=apptest_collection
# 管理界面端口（Attu / Milvus Web UI）
MILVUS_CONSOLE_PORT=9091

# MinIO（bucket 不存在时自动创建）
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=apptest-bucket
MINIO_SECURE=false
# 管理界面端口（MinIO Console）
MINIO_CONSOLE_PORT=9001

USAGE_DATABASE=data/usage.sqlite3
UPLOAD_TEMP_DIR=data/uploads
MAX_UPLOAD_MB=100
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# MinerU 2.x/3.x 服务地址；留空则 PDF/图片回退到 MarkItDown。
MINERU_URL=http://your-mineru-host:8000
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANG=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_TIMEOUT=900
# hybrid 系列后端的解析力度：medium（快）/ high（含图表分析）
MINERU_EFFORT=medium
MINERU_IMAGE_ANALYSIS=true
# 通过 /tasks 异步提交并轮询，避免长文档占住连接，同时能看到队列位置
MINERU_ASYNC=true
MINERU_POLL_SECONDS=2
# MinerU 不可用时是否回退到本地 MarkItDown
MINERU_FALLBACK_TO_MARKITDOWN=true
# 交给 MinerU 的扩展名（实际仅 PDF/图片/DOCX/PPTX/XLSX 会被 MinerU 接受，其余走本地转换器）
MINERU_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.gif,.webp,.docx,.pptx,.xlsx
# 本机同时进行的转换任务数（MinerU 自身并发上限较小，过多只会在其队列里堆积）
CONVERSION_WORKERS=2

HOST=127.0.0.1
PORT=8000
